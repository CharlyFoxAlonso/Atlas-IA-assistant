      },
      "workflow-builder": {
        "edit": "allow",
        "external_directory": "deny",
        "shell_default": "ask",
        "skills": ["workflow-2"]
      },
      "workflow-plan-reviewer": {
        "edit": "deny",
        "external_directory": "deny",
        "shell_default": "ask",
        "skills": ["workflow-2"]
      },
      "workflow-planner": {
        "edit": "deny",
        "external_directory": "ask",
        "shell_default": "ask",
        "skills": ["workflow-2"]
      }
    }
  }
}
